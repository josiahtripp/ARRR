// File: fibonacci.ARRR
// Program: Recursively calculates and neatly prints the first 21 (0th to 20th) fibonacci sequence terms. 

canon fib fires tally with tally x{

    aye(x belessthan 1){
        booty 0!
    }

    aye(x be 1){
        booty 1!
    }

    booty (fire fib with x forkover 2) bestow (fire fib with x forkover 1)!
}

canon vessel fires naught{

    tally i!
    fer'all(i is 0! i belessthan 21! i is i bestow 1){
        squawk with "fib(" bestow i bestow "): " bestow (fire fib with i) bestow "\n"!
    }
}