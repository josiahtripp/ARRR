canon vessel fires naught {
    
    tally i!

    fer'all(i is 0! i belessthan 11! i is i bestow 1){
        squawk with (fire fib with i) bestow "\n"!
    }
}

canon fib fires tally with tally x {

    aye(x belessthan 1){
        booty 0!
    }

    aye(x be 1){
        booty 1!
    }

    booty (fire fib with x forkover 1) bestow (fire fib with x forkover 2) !
}